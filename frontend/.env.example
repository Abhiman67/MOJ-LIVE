# ==========================================
# MongoDB Configuration
# ==========================================
# In local development: mongodb://localhost:27017/myonlinejet
# In production: Your MongoDB Atlas connection string (replace username, password, and cluster details)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/myonlinejet?retryWrites=true&w=majority

# ==========================================
# Authentication & Security
# ==========================================
# Generate a secret using: openssl rand -base64 33
JWT_SECRET=change_this_to_a_random_secret_using_openssl_rand_base64_33
JWT_EXPIRES_IN=24h

# Auth.js / NextAuth v5 secrets
# Generate a secret using: openssl rand -base64 33
AUTH_SECRET=change_this_to_a_random_secret_using_openssl_rand_base64_33
# Optional on Vercel (automatically detected), but required for local auth: http://localhost:3000
AUTH_URL=http://localhost:3000

# Credentials Auth Configuration
AUTH_CREDENTIALS_ENABLED=true
NEXT_PUBLIC_AUTH_CREDENTIALS_ENABLED=true

# ==========================================
# Admin Seed Credentials
# ==========================================
ADMIN_EMAIL=admin@myonlinejet.com
ADMIN_PASSWORD=use_a_unique_password_with_at_least_12_characters
# Seed scripts are blocked unless this is explicitly set for a controlled environment.
ALLOW_SEED=false

# ==========================================
# Email & SMTP Server
# ==========================================
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ==========================================
# Notification Settings
# ==========================================
NOTIFICATION_EMAIL=contact@myonlinejet.com
FROM_EMAIL=noreply@myonlinejet.com

# ==========================================
# Upload Settings
# ==========================================
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# ==========================================
# OAuth Providers (Optional)
# ==========================================
# Google Console credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Apple Developer credentials
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# LinkedIn OAuth credentials
AUTH_LINKEDIN_ID=
AUTH_LINKEDIN_SECRET=

# Public flags that control which social buttons appear on /auth.
# Set to true only for providers with credentials configured above.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=true
NEXT_PUBLIC_AUTH_APPLE_ENABLED=false
NEXT_PUBLIC_AUTH_LINKEDIN_ENABLED=false
