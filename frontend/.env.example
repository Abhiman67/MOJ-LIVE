# ==========================================
# MongoDB Configuration
# ==========================================
# In local development: mongodb://localhost:27017/myonlinejet
# In production: Your MongoDB Atlas connection string (replace username, password, and cluster details)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/myonlinejet?retryWrites=true&w=majority

# ==========================================
# Authentication & Security
# ==========================================
# Generate a secret using: openssl rand -base64 33
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# Auth.js / NextAuth v5 secrets
# Generate a secret using: openssl rand -base64 33
AUTH_SECRET=your_auth_secret_key_here
# Optional on Vercel (automatically detected), but required for local auth: http://localhost:3000
AUTH_URL=http://localhost:3000

# Credentials Auth Configuration
AUTH_CREDENTIALS_ENABLED=true
NEXT_PUBLIC_AUTH_CREDENTIALS_ENABLED=true

# ==========================================
# Admin Seed Credentials
# ==========================================
ADMIN_EMAIL=admin@myonlinejet.com
ADMIN_PASSWORD=admin_secure_password_here

# ==========================================
# Email & SMTP Server
# ==========================================
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ==========================================
# Notification Settings
# ==========================================
NOTIFICATION_EMAIL=contact@myonlinejet.com
FROM_EMAIL=noreply@myonlinejet.com

# ==========================================
# Upload Settings
# ==========================================
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# ==========================================
# OAuth Providers (Optional)
# ==========================================
# Google Console credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Apple Developer credentials
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
